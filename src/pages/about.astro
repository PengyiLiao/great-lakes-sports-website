---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { about } from "../content/about";
import { site } from "../config/site";
---

<BaseLayout
  title="About"
  description="Great Lakes Sports Inc. is a Canadian sports organization headquartered in Toronto, Ontario, developing internationally recognized amateur sporting events."
>
  <PageHeader eyebrow={site.legalName} title="About Us" />

  {/* Introduction */}
  <section class="mx-auto max-w-3xl px-6">
    <div class="space-y-6 text-lg text-ink-muted">
      {about.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  {/* Vision and mission, presented as a symmetrical pair. The vertical rule
      between them only appears once there is room for two columns. */}
  <section class="mx-auto mt-20 max-w-5xl px-6">
    <div class="grid gap-12 md:grid-cols-2 md:gap-0">
      <div class="text-center md:px-12">
        <h2 class="text-xs tracking-[0.3em] text-gold-600 uppercase">
          Our Vision
        </h2>
        <p class="mt-6 font-display text-2xl text-forest-900 sm:text-3xl">
          {about.vision}
        </p>
      </div>

      <div class="text-center md:border-l md:border-gold-400/40 md:px-12">
        <h2 class="text-xs tracking-[0.3em] text-gold-600 uppercase">
          Our Mission
        </h2>
        <p class="mt-6 font-display text-2xl text-forest-900 sm:text-3xl">
          {about.mission}
        </p>
      </div>
    </div>
  </section>

  {/* Core values — a full-width band in the brand green. The change of ground
      gives the page a clear rhythm and stops it reading as one long column. */}
  <section class="mt-24 bg-forest-900 py-16 text-center sm:py-20">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="text-xs tracking-[0.3em] text-gold-300 uppercase">
        Our Core Values
      </h2>

      <ul
        class="mt-10 flex flex-col items-center justify-center gap-y-6 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-8"
      >
        {
          about.coreValues.map((value, index) => (
            <li class="flex items-center gap-x-10">
              {index > 0 && (
                <span
                  aria-hidden="true"
                  class="hidden h-1.5 w-1.5 rotate-45 bg-gold-400 sm:block"
                />
              )}
              <span class="font-display text-2xl text-ivory-100 sm:text-[1.75rem]">
                {value}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Closing statement */}
  <section class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-24">
    <p class="font-display text-2xl text-forest-900 italic sm:text-3xl">
      {about.closing}
    </p>
  </section>

  {/* Chairman's message */}
  <section class="bg-ivory-200 py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-6">
      <h2
        class="text-center text-xs tracking-[0.3em] text-gold-600 uppercase"
      >
        Chairman's Message
      </h2>

      <div class="mx-auto mt-8 h-px w-20 bg-gold-400"></div>

      <div class="mt-12 space-y-6 text-lg text-ink-muted">
        {about.chairman.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-12 border-t border-gold-400/50 pt-8">
        <p class="font-display text-2xl text-forest-900">
          {about.chairman.name}
        </p>
        <p class="mt-2 text-sm tracking-[0.18em] text-ink-muted uppercase">
          {about.chairman.title}, {about.chairman.organization}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
