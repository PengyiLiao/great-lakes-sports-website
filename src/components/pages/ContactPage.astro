---
/**
 * Contact page body, rendered once per language.
 *
 * The page names six audiences rather than offering a single generic form:
 * a visitor should recognise themselves in one line and know their message
 * will reach the right person.
 *
 * No address is invented. Until the client supplies one, the page says so —
 * a mailbox nobody reads does more damage than a stated gap.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Button from "../Button.astro";
import { contactEmail, site } from "../../config/site";
import { contact } from "../../content/contact";
import type { Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = contact[lang];
---

<BaseLayout lang={lang} route="/contact" title={t("page.contact")}>
  <PageHeader
    eyebrow={t("nav.contact")}
    title={t("contact.lede")}
    lede={copy.intro}
  />

  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("contact.audiences")}</p>

    <dl class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.audiences.map((audience) => (
          <div class="border-t-2 border-forest-900 pt-5">
            <dt class="font-display text-xl font-bold tracking-tight text-forest-900 uppercase sm:text-2xl">
              {audience.title}
            </dt>
            <dd class="mt-3 text-ink-muted">{audience.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-forest-950 py-20 text-center text-ivory-50 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-4xl uppercase sm:text-5xl">{copy.closing}</h2>

      <div class="mt-12">
        {
          contactEmail ? (
            <Button href={`mailto:${contactEmail}`} variant="onDark">
              {contactEmail}
            </Button>
          ) : (
            <p class="eyebrow text-gold-300">{t("cta.enquirePending")}</p>
          )
        }
      </div>

      <p class="mt-14 text-ivory-300">{site.location}</p>
    </div>
  </section>
</BaseLayout>
