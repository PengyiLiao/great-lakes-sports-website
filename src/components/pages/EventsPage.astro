---
/**
 * Events page body, rendered once per language.
 *
 * Shows the scheduled tournament first and the standing series after it. A
 * visitor arriving from a poster or a group chat wants a date before they
 * want a competition structure.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Button from "../Button.astro";
import {
  eventPageSections,
  eventSeries,
  events,
  futureSeries,
} from "../../content/events";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="/events" title={t("page.events")}>
  <PageHeader
    eyebrow={t("nav.events")}
    title={t("page.events")}
    lede={t("events.lede")}
  />

  {/* Scheduled */}
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <h2 class="text-3xl uppercase text-forest-900 sm:text-4xl">
      {t("home.upcoming")}
    </h2>

    {
      events.length > 0 ? (
        <ul class="mt-12 space-y-6">
          {events.map((event) => {
            const e = event.localized[lang];
            return (
              <li class="border border-forest-900/15 bg-ivory-100 p-8 sm:p-12">
                <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
                  <time
                    datetime={event.date}
                    class="font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl"
                  >
                    {e.displayDate}
                  </time>
                  <p class="eyebrow text-gold-600">{e.location}</p>
                </div>

                <h3 class="mt-5 text-3xl uppercase text-forest-900 sm:text-4xl">
                  {e.name}
                </h3>
                <p class="mt-3 text-lg text-ink-muted">{event.venue}</p>

                <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
                  {e.facts.map((fact) => (
                    <div class="border-t border-forest-900/15 pt-4">
                      <dt class="eyebrow text-ink-muted">{fact.label}</dt>
                      <dd class="mt-2 font-display text-lg font-semibold text-forest-900">
                        {fact.value}
                      </dd>
                    </div>
                  ))}
                </dl>

                <div class="mt-10">
                  <Button href={localizePath("/register", lang)}>
                    {t("cta.register")}
                  </Button>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mt-10 text-lg text-ink-muted">{t("home.upcoming.empty")}</p>
      )
    }
  </section>

  {/* Standing series */}
  <section class="bg-ivory-200 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow text-gold-600">{t("events.series")}</p>

      <ul class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-3">
        {
          eventSeries.map((series) => (
            <li class="border-t-2 border-forest-900 pt-6">
              <h2 class="text-2xl uppercase text-forest-900 sm:text-3xl">
                {series.name}
              </h2>
              <p class="mt-5 text-ink-muted">{series.description[lang]}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Announced but unscheduled */}
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("events.future")}</p>

    <ul class="mt-8 flex flex-wrap gap-3">
      {
        futureSeries.map((name) => (
          <li class="border border-forest-900/20 px-5 py-3 font-display text-base font-semibold tracking-[0.06em] text-forest-800 uppercase">
            {name}
          </li>
        ))
      }
    </ul>
  </section>

  {/* What an event page will carry */}
  <section class="bg-forest-950 py-20 text-ivory-50 sm:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow text-gold-300">{t("events.detailFields")}</p>

      <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          eventPageSections[lang].map((section) => (
            <li class="border-t border-ivory-200/25 pt-4 font-display text-lg font-semibold tracking-[0.04em] uppercase">
              {section}
            </li>
          ))
        }
      </ul>

      <div class="mt-14">
        <Button href={localizePath("/contact", lang)} variant="onDark">
          {t("cta.contact")}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
