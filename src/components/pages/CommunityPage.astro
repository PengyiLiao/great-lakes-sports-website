---
/**
 * Community page body, rendered once per language.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Button from "../Button.astro";
import { community } from "../../content/community";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = community[lang];
---

<BaseLayout lang={lang} route="/community" title={t("page.community")}>
  <PageHeader
    eyebrow="GAG Community"
    title={t("page.community")}
    lede={copy.intro}
  />

  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("community.who")}</p>

    <dl class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.groups.map((group) => (
          <div class="border-t-2 border-forest-900 pt-5">
            <dt class="text-xl uppercase text-forest-900 sm:text-2xl">
              <span class="font-display font-bold tracking-tight">
                {group.title}
              </span>
            </dt>
            <dd class="mt-3 text-ink-muted">{group.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="bg-forest-950 py-20 text-center text-ivory-50 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {t("community.lede")}
      </p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <Button href={localizePath("/partners", lang)} variant="onDark">
          {t("cta.partner")}
        </Button>
        <Button href={localizePath("/contact", lang)} variant="onDark">
          {t("cta.contact")}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
