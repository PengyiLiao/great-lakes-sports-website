---
/**
 * About page body, rendered once per language.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Button from "../Button.astro";
import { about } from "../../content/about";
import { site } from "../../config/site";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = about[lang];
---

<BaseLayout lang={lang} route="/about" title={t("page.about")}>
  <PageHeader
    eyebrow={`${site.name} — ${site.fullName}`}
    title={t("about.who")}
    lede={copy.who[0]}
  />

  {/* Who we are */}
  <section class="mx-auto max-w-4xl px-6 py-20 sm:py-24">
    <div class="space-y-6 text-lg text-ink-muted">
      {copy.who.slice(1).map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <ul class="mt-12 flex flex-wrap gap-x-10 gap-y-3">
      {
        copy.whoClosing.map((line) => (
          <li class="font-display text-xl font-bold tracking-tight text-forest-900 sm:text-2xl">
            {line}
          </li>
        ))
      }
    </ul>
  </section>

  {/* Vision */}
  <section class="bg-forest-950 py-20 text-ivory-50 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="eyebrow text-gold-300">{t("about.vision")}</p>
      <p class="mt-6 font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {copy.vision.line}
      </p>
      <div class="mt-8 space-y-5 text-lg text-ivory-200">
        {copy.vision.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <p class="mt-10 font-display text-2xl font-bold tracking-tight text-gold-300 uppercase">
        {copy.vision.closing}
      </p>
    </div>
  </section>

  {/* Mission */}
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("about.mission")}</p>
    <h2 class="mt-6 max-w-3xl text-3xl uppercase text-forest-900 sm:text-4xl">
      {copy.mission.line}
    </h2>
    <p class="mt-6 max-w-2xl text-lg text-ink-muted">{copy.mission.intro}</p>

    <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {
        copy.mission.pillars.map((pillar, index) => (
          <li class="border-t-2 border-forest-900 pt-6">
            <p class="eyebrow text-gold-600">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-xl uppercase text-forest-900 sm:text-2xl">
              {pillar.title}
            </h3>
            <p class="mt-4 text-ink-muted">{pillar.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Story */}
  <section class="bg-ivory-200 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <p class="eyebrow text-gold-600">{t("about.story")}</p>
      <h2 class="mt-6 text-3xl uppercase text-forest-900 sm:text-4xl">
        {copy.story.line}
      </h2>

      <div class="mt-8 space-y-6 text-lg text-ink-muted">
        {copy.story.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="mt-12 space-y-3 border-l-2 border-gold-400 pl-6">
        {
          copy.story.stance.map((line) => (
            <li class="font-display text-xl font-semibold tracking-tight text-forest-900">
              {line}
            </li>
          ))
        }
      </ul>

      <p class="mt-12 text-lg text-ink-muted">{copy.story.closing}</p>
    </div>
  </section>

  {/* Values */}
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("about.values")}</p>

    <ul class="mt-12 grid gap-x-10 gap-y-12 md:grid-cols-3">
      {
        copy.values.pillars.map((pillar) => (
          <li>
            <h3 class="text-3xl uppercase text-forest-900 sm:text-4xl">
              {pillar.title}
            </h3>
            <div class="mt-5 h-0.5 w-12 bg-gold-400" />
            <p class="mt-5 text-ink-muted">{pillar.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-16 font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl">
      {copy.values.closing}
    </p>
  </section>

  {/* Governance */}
  <section class="bg-forest-950 py-20 text-ivory-50 sm:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow text-gold-300">{t("about.governance")}</p>
      <h2 class="mt-6 text-3xl uppercase sm:text-4xl">{copy.governance.line}</h2>
      <p class="mt-6 max-w-2xl text-lg text-ivory-200">{copy.governance.intro}</p>

      <dl class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          copy.governance.principles.map((principle) => (
            <div class="border-t border-ivory-200/25 pt-5">
              <dt class="font-display text-lg font-semibold tracking-[0.06em] text-gold-300 uppercase">
                {principle.title}
              </dt>
              <dd class="mt-3 text-ivory-200">{principle.body}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-14 font-display text-2xl font-bold tracking-tight sm:text-3xl">
        {copy.governance.closing}
      </p>
    </div>
  </section>

  {/* Youth Golf Fund */}
  <section class="mx-auto max-w-4xl px-6 py-20 sm:py-24">
    <p class="eyebrow text-gold-600">{t("about.fund")}</p>
    <h2 class="mt-6 text-3xl uppercase text-forest-900 sm:text-4xl">
      {copy.fund.line}
    </h2>

    <div class="mt-8 space-y-5 text-lg text-ink-muted">
      {copy.fund.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <ul class="mt-10 flex flex-wrap gap-3">
      {
        copy.fund.areas.map((area) => (
          <li class="border border-forest-900/20 px-4 py-2 font-display text-sm font-semibold tracking-[0.08em] text-forest-800 uppercase">
            {area}
          </li>
        ))
      }
    </ul>

    <p class="mt-12 font-display text-2xl font-bold tracking-tight text-forest-900">
      {copy.fund.closing}
    </p>

    <div class="mt-12">
      <Button href={localizePath("/contact", lang)}>{t("cta.contact")}</Button>
    </div>
  </section>
</BaseLayout>
