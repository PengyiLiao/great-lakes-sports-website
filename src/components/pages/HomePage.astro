---
/**
 * Home page body, rendered once per language.
 *
 * Follows the order of the client's Copy Deck: the brand line, what GAG is,
 * who it is for, what is coming up, and then the three sections that carry
 * the rest of the platform.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../Button.astro";
import GagLogo from "../GagLogo.astro";
import { site } from "../../config/site";
import { events } from "../../content/events";
import { home } from "../../content/home";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = home[lang];
---

<BaseLayout lang={lang} route="/" title={t("page.home")}>
  {/* Hero. Not full-viewport height — leaving the next section visible at the
      fold tells visitors there is more below, which a full-screen splash
      does not. */}
  <section class="bg-forest-950 text-ivory-50">
    <div class="mx-auto max-w-7xl px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
      <p class="eyebrow text-gold-300">
        {site.name} — {site.fullName}
      </p>

      <h1 class="mt-6 text-6xl uppercase sm:text-7xl md:text-8xl">
        Let's Play GAG!
      </h1>

      <p
        class="mt-8 max-w-2xl font-display text-2xl font-medium text-ivory-200 sm:text-3xl"
      >
        {t("home.tagline")}
      </p>

      <div class="mt-12 flex flex-wrap gap-4">
        <Button href={localizePath("/events", lang)} variant="onDark">
          {t("cta.joinEvent")}
        </Button>
        <Button href={localizePath("/players", lang)} variant="onDark">
          {t("cta.meetPlayers")}
        </Button>
        <Button href={localizePath("/about", lang)} variant="onDark">
          {t("cta.aboutGag")}
        </Button>
      </div>
    </div>
  </section>

  {/* What GAG is */}
  <section class="mx-auto max-w-4xl px-6 py-20 sm:py-28">
    <h2 class="text-3xl uppercase text-forest-900 sm:text-4xl">
      {t("home.moreThan")}
    </h2>
    <p class="mt-8 text-lg text-ink-muted sm:text-xl">{copy.positioning}</p>
  </section>

  {/* What GAG is for.
      The Copy Deck puts the 16–25 age ladder here. On the Players page those
      bands read as who the platform is built for; blown up on the landing
      page they read as an entry requirement — and the first tournament is
      open well beyond them. So the home page carries the four things GAG
      exists to give players instead, and the ladder stays on /players where
      the surrounding copy explains it. */}
  <section class="bg-ivory-200 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow text-gold-600">{t("home.purpose")}</p>

      <ul class="mt-12 grid gap-px border border-forest-900/10 bg-forest-900/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          copy.pillars.map((pillar, index) => (
            <li class="bg-ivory-50 p-8 sm:p-10">
              <p class="eyebrow text-gold-600">
                {String(index + 1).padStart(2, "0")}
              </p>
              <p class="mt-4 font-display text-3xl font-bold tracking-tight text-forest-900 uppercase sm:text-4xl">
                {pillar}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="mt-12 font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl">
        {t("home.nextLevel")}
      </p>
    </div>
  </section>

  {/* Upcoming events */}
  <section class="mx-auto max-w-7xl px-6 py-20 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-3xl uppercase text-forest-900 sm:text-4xl">
        {t("home.upcoming")}
      </h2>
      <Button href={localizePath("/events", lang)} variant="outline">
        {t("cta.viewEvents")}
      </Button>
    </div>

    {
      events.length > 0 ? (
        <ul class="mt-12 space-y-6">
          {events.map((event) => {
            const e = event.localized[lang];
            return (
              <li class="border border-forest-900/15 bg-ivory-100 p-8 sm:p-12">
                <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
                  <time
                    datetime={event.date}
                    class="font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl"
                  >
                    {e.displayDate}
                  </time>
                  <p class="eyebrow text-gold-600">{e.location}</p>
                </div>

                <h3 class="mt-5 text-3xl uppercase text-forest-900 sm:text-4xl">
                  {e.name}
                </h3>
                <p class="mt-3 text-lg text-ink-muted">{event.venue}</p>

                <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
                  {e.facts.map((fact) => (
                    <div class="border-t border-forest-900/15 pt-4">
                      <dt class="eyebrow text-ink-muted">{fact.label}</dt>
                      <dd class="mt-2 font-display text-lg font-semibold text-forest-900">
                        {fact.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mt-12 text-lg text-ink-muted">{t("home.upcoming.empty")}</p>
      )
    }
  </section>

  {/* The three sections that carry the rest of the platform */}
  <section class="bg-forest-950 py-20 text-ivory-50 sm:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <ul class="grid gap-12 md:grid-cols-3">
        {
          copy.teasers.map((teaser) => (
            <li class="flex flex-col border-t-2 border-gold-400 pt-8">
              <h2 class="text-2xl uppercase sm:text-3xl">{teaser.line}</h2>
              <p class="mt-5 flex-1 text-ivory-200">{teaser.body}</p>
              <a
                href={localizePath(teaser.route, lang)}
                class="mt-8 font-display text-[0.8125rem] font-semibold tracking-[0.14em] text-gold-300 uppercase transition-colors hover:text-gold-200"
              >
                {t(
                  teaser.route === "/players"
                    ? "home.players"
                    : teaser.route === "/university"
                      ? "home.university"
                      : "home.community",
                )} →
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Closing brand line */}
  <section class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-28">
    <GagLogo class="text-5xl text-forest-900" maple />
    <p class="mt-8 font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl">
      Rooted in the Great Lakes. Connected to the World.
    </p>
  </section>
</BaseLayout>
