---
/**
 * Registration page body, rendered once per language.
 *
 * Entries are handled by a hosted form, not by anything on this site. The
 * page's job is everything around that link: which event, who may enter,
 * what to have ready, what happens for players under 18, and what the site
 * will and will not publish about an entrant.
 *
 * That framing matters more than it looks. A bare link to a form asks a
 * sixteen-year-old and their parent to hand over personal details with no
 * statement of what becomes of them; saying it plainly beforehand is both
 * the decent thing and the reason the form gets completed rather than
 * abandoned.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../PageHeader.astro";
import Button from "../Button.astro";
import { contactEmail, registrationUrl } from "../../config/site";
import { events } from "../../content/events";
import { register } from "../../content/register";
import { localizePath, type Lang } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = register[lang];

/** Entries currently run one event at a time. */
const nextEvent = events[0];
---

<BaseLayout lang={lang} route="/register" title={t("page.register")}>
  <PageHeader
    eyebrow={t("page.register")}
    title={t("cta.register")}
    lede={copy.intro}
  />

  {/* Which event */}
  {
    nextEvent && (
      <section class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
        <div class="border border-forest-900/15 bg-ivory-100 p-8 sm:p-12">
          <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
            <time
              datetime={nextEvent.date}
              class="font-display text-2xl font-bold tracking-tight text-forest-900 sm:text-3xl"
            >
              {nextEvent.localized[lang].displayDate}
            </time>
            <p class="eyebrow text-gold-600">
              {nextEvent.localized[lang].location}
            </p>
          </div>

          <h2 class="mt-5 text-3xl uppercase text-forest-900 sm:text-4xl">
            {nextEvent.localized[lang].name}
          </h2>
          <p class="mt-3 text-lg text-ink-muted">{nextEvent.venue}</p>

          <dl class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
            {nextEvent.localized[lang].facts.map((fact) => (
              <div class="border-t border-forest-900/15 pt-4">
                <dt class="eyebrow text-ink-muted">{fact.label}</dt>
                <dd class="mt-2 font-display text-lg font-semibold text-forest-900">
                  {fact.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }

  {/* What to have ready */}
  <section class="bg-ivory-200 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl uppercase text-forest-900 sm:text-4xl">
        {copy.checklistTitle}
      </h2>

      <ul class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {
          copy.checklist.map((item) => (
            <li class="flex gap-3 border-t border-forest-900/15 pt-4 text-ink-muted">
              <span aria-hidden="true" class="text-gold-600">
                —
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Under 18 */}
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
    <h2 class="text-3xl uppercase text-forest-900 sm:text-4xl">
      {copy.minorsTitle}
    </h2>
    <p class="mt-6 border-l-2 border-gold-400 pl-6 text-lg text-ink-muted">
      {copy.minors}
    </p>
  </section>

  {/* What is published */}
  <section class="bg-forest-950 py-16 text-ivory-50 sm:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="eyebrow text-gold-300">{copy.privacyTitle}</p>

      <div class="mt-8 space-y-5 text-lg text-ivory-200">
        <p>{copy.privacyPublished}</p>
        <p>{copy.privacyWithheld}</p>
      </div>

      <p class="mt-8">
        <a
          href={localizePath("/players", lang)}
          class="font-display text-[0.8125rem] font-semibold tracking-[0.14em] text-gold-300 uppercase transition-colors hover:text-gold-200"
        >
          {t("players.privacy")} →
        </a>
      </p>
    </div>
  </section>

  {/* The entry form itself */}
  <section class="mx-auto max-w-4xl px-6 py-20 text-center sm:py-24">
    {
      registrationUrl ? (
        <Button href={registrationUrl}>{t("cta.register")}</Button>
      ) : (
        <>
          <p class="text-lg text-ink-muted">{copy.pending}</p>
          <div class="mt-10">
            {contactEmail ? (
              <Button href={`mailto:${contactEmail}`} variant="outline">
                {t("cta.enquire")}
              </Button>
            ) : (
              <Button href={localizePath("/contact", lang)} variant="outline">
                {t("cta.contact")}
              </Button>
            )}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
