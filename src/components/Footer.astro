---
/**
 * Site footer.
 *
 * Carries the brand line and the full navigation, so the foot of any page is
 * also a map of the site. The legal links are listed but not yet linked —
 * a privacy policy that 404s is worse than one that is visibly pending, and
 * this site publishes profiles of minors, so those documents matter.
 *
 * The year is evaluated at build time. Because the site redeploys on every
 * content change this stays current in practice, and it avoids shipping
 * JavaScript for something a static build already knows.
 */
import GagLogo from "./GagLogo.astro";
import { localizePath, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { nav, site } from "../config/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();

const legal =
  lang === "en"
    ? ["Privacy Policy", "Terms of Use", "Player Privacy"]
    : ["Politique de confidentialité", "Conditions d'utilisation", "Vie privée des joueurs"];
---

<footer class="mt-auto bg-forest-950 text-ivory-200">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
    <div class="text-center">
      <GagLogo class="text-5xl text-ivory-50" maple />

      <p class="mt-6 font-display text-2xl font-bold tracking-tight text-gold-300 sm:text-3xl">
        Let's Play GAG!
      </p>

      <p class="mt-3 text-sm text-ivory-300">
        Rooted in the Great Lakes. Connected to the World.
      </p>
    </div>

    <nav aria-label={t("a11y.footerNav")} class="mt-14">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          nav.map((item) => (
            <li>
              <a
                href={localizePath(item.route, lang)}
                class="font-display text-[0.8125rem] font-semibold tracking-[0.14em] text-ivory-300 uppercase transition-colors hover:text-gold-300"
              >
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div
      class="mt-14 border-t border-ivory-200/15 pt-8 text-center text-sm text-ivory-300/80"
    >
      {/* Not yet links: these documents do not exist, and this site will
          publish profiles of players under 18, so they are not placeholders
          to fake. Listing them keeps the obligation visible. */}
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {legal.map((label) => <li>{label}</li>)}
      </ul>

      <p class="mt-6">{site.location}</p>
      <p class="mt-1">
        &copy; {year} {site.legalName}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
