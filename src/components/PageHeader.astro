---
/**
 * The masthead at the top of an interior page.
 *
 * Set on the brand green with large, tight, left-aligned display type. The
 * previous centred-and-gold-ruled treatment read as a heritage club; this one
 * reads as a competition — which is the difference the brief asks for.
 */
interface Props {
  /** Small line above the title. */
  eyebrow?: string;
  title: string;
  /** Optional standfirst — the page's one-line proposition. */
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="bg-forest-950 text-ivory-50">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:py-28">
    {eyebrow && <p class="eyebrow text-gold-300">{eyebrow}</p>}

    <h1 class="mt-5 text-5xl uppercase sm:text-6xl md:text-7xl">
      {title}
    </h1>

    {
      lede && (
        <p class="mt-8 max-w-2xl font-display text-xl font-medium text-ivory-200 sm:text-2xl">
          {lede}
        </p>
      )
    }
  </div>
</section>
