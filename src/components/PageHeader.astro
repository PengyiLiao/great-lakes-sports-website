---
/**
 * The masthead at the top of an interior page.
 *
 * Centred, with a gold rule beneath the title, so that every section of the
 * site opens the same way and a visitor always knows where they have landed.
 */
interface Props {
  /** Small line above the title — section or category. */
  eyebrow?: string;
  title: string;
  /** Optional standfirst beneath the rule. */
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="mx-auto max-w-3xl px-6 pt-16 pb-10 text-center sm:pt-24 sm:pb-14">
  {
    eyebrow && (
      <p class="text-xs tracking-[0.32em] text-gold-600 uppercase sm:text-sm">
        {eyebrow}
      </p>
    )
  }

  <h1 class="mt-6 font-display text-4xl text-forest-900 sm:text-5xl">
    {title}
  </h1>

  <div class="mx-auto mt-8 h-px w-20 bg-gold-400"></div>

  {lede && <p class="mt-8 text-lg text-ink-muted">{lede}</p>}
</section>
