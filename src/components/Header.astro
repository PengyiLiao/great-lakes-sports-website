---
/**
 * Site header.
 *
 * The earlier build kept every link visible at all widths, on the reasoning
 * that the audience skewed older and a collapsed menu hides the site behind
 * an icon not everyone reads as a button. Both premises have changed: the
 * platform is now aimed at golfers aged 16–25, and the navigation has grown
 * from three items to seven, which cannot sit on one line on a phone.
 *
 * So narrow screens get a disclosure — built on <details>/<summary> rather
 * than a scripted menu. It opens and closes with no JavaScript at all, is
 * keyboard operable and screen-reader labelled by the browser itself, and
 * therefore still works if a script fails to load.
 */
import LanguageSwitcher from "./LanguageSwitcher.astro";
import GagLogo from "./GagLogo.astro";
import { localizePath, type Lang } from "../i18n/config";
import { useTranslations } from "../i18n/ui";
import { nav } from "../config/site";

interface Props {
  lang: Lang;
  /** Canonical, unprefixed route of the current page. */
  route: string;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);

const linkBase =
  "font-display text-[0.8125rem] font-semibold tracking-[0.14em] uppercase transition-colors";
---

<header
  class="sticky top-0 z-50 border-b border-forest-900/10 bg-ivory-50/95 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4">
    <a
      href={localizePath("/", lang)}
      class="shrink-0 text-forest-900 transition-colors hover:text-forest-700"
    >
      <GagLogo class="text-3xl" />
    </a>

    {/* Wide screens: everything on one line. */}
    <div class="hidden items-center gap-8 lg:flex">
      <nav aria-label={t("a11y.mainNav")}>
        <ul class="flex items-center gap-7">
          {
            nav.map((item) => {
              const isCurrent = item.route === route;
              return (
                <li>
                  <a
                    href={localizePath(item.route, lang)}
                    aria-current={isCurrent ? "page" : undefined}
                    class:list={[
                      linkBase,
                      "relative py-1",
                      "after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-gold-400 after:transition-transform after:duration-200",
                      isCurrent
                        ? "text-forest-900 after:scale-x-100"
                        : "text-ink-muted after:scale-x-0 hover:text-forest-900 hover:after:scale-x-100",
                    ]}
                  >
                    {t(item.key)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="flex items-center gap-5 border-l border-forest-900/15 pl-6">
        <LanguageSwitcher lang={lang} route={route} />
        <a
          href={localizePath("/events", lang)}
          class:list={[linkBase, "bg-forest-900 px-5 py-2.5 text-ivory-50 hover:bg-forest-700"]}
        >
          {t("cta.play")}
        </a>
      </div>
    </div>

    {/* Narrow screens: a no-JavaScript disclosure. */}
    <details class="group relative lg:hidden">
      <summary
        class:list={[
          linkBase,
          "flex cursor-pointer list-none items-center gap-2 text-forest-900 [&::-webkit-details-marker]:hidden",
        ]}
      >
        <span class="group-open:hidden">{t("nav.menu")}</span>
        <span class="hidden group-open:inline">{t("nav.close")}</span>
        <svg viewBox="0 0 20 14" class="h-3 w-5" fill="none" aria-hidden="true">
          <path
            class="group-open:hidden"
            d="M0 1h20M0 7h20M0 13h20"
            stroke="currentColor"
            stroke-width="2"
          />
          <path
            class="hidden group-open:block"
            d="M2 1l16 12M18 1L2 13"
            stroke="currentColor"
            stroke-width="2"
          />
        </svg>
      </summary>

      <div
        class="absolute right-0 z-50 mt-4 w-64 border border-forest-900/10 bg-ivory-50 p-6 shadow-xl"
      >
        <nav aria-label={t("a11y.mainNav")}>
          <ul class="flex flex-col gap-4">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={localizePath(item.route, lang)}
                    aria-current={item.route === route ? "page" : undefined}
                    class:list={[
                      linkBase,
                      "block",
                      item.route === route
                        ? "text-forest-900"
                        : "text-ink-muted hover:text-forest-900",
                    ]}
                  >
                    {t(item.key)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div
          class="mt-6 flex items-center justify-between border-t border-forest-900/10 pt-5"
        >
          <LanguageSwitcher lang={lang} route={route} />
        </div>

        <a
          href={localizePath("/events", lang)}
          class:list={[linkBase, "mt-5 block bg-forest-900 px-5 py-3 text-center text-ivory-50"]}
        >
          {t("cta.play")}
        </a>
      </div>
    </details>
  </div>
</header>
